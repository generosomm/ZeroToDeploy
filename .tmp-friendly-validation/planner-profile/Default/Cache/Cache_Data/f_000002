/* Components used by the focused five-step guide. */

/* Header */
.brand { display: flex; align-items: center; gap: 12px; }
.brand-icon { color: var(--text); display: grid; place-items: center; }
.brand-title { font: 700 20px 'Space Grotesk', sans-serif; letter-spacing: -.02em; }
.brand-tag { display: block; color: var(--text-dim); text-transform: uppercase; letter-spacing: .1em; font: 400 10px 'IBM Plex Mono', monospace; }
.header-path {
  color: var(--text-dim); border: 1px solid var(--line); border-radius: 99px;
  padding: 9px 14px; font: 500 10px 'IBM Plex Mono', monospace;
}
.header-path span { color: var(--teal); margin-right: 8px; }
.btn-icon {
  width: 38px; height: 38px; flex: 0 0 auto; display: grid; place-items: center;
  border: 1px solid var(--line); border-radius: 50%; background: var(--surface);
  color: var(--text-dim); cursor: pointer; transition: .2s ease;
}
.btn-icon:hover { border-color: var(--teal); color: var(--teal); transform: translateY(-1px); }

/* Shared controls */
.btn-sm-primary,
.btn-secondary {
  min-height: 40px; padding: 9px 18px; display: inline-flex; align-items: center;
  justify-content: center; gap: 8px; border-radius: 99px; cursor: pointer;
  font: 700 12px 'Space Grotesk', sans-serif; transition: .2s ease;
}
.btn-sm-primary { border: 1px solid var(--gold); background: var(--gold); color: #fff; }
.btn-secondary { border: 1px solid var(--line); background: transparent; color: var(--text); }
.btn-sm-primary:hover,
.btn-secondary:hover { transform: translateY(-2px); box-shadow: 0 8px 22px var(--gold-glow); }
.btn-secondary:hover { border-color: var(--teal); color: var(--teal); }
button:disabled { cursor: not-allowed; opacity: .38; transform: none !important; box-shadow: none !important; }

/* Section framing */
.focused-section-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 30px; }
.section-outcome {
  width: 260px; flex: 0 0 auto; padding: 14px 16px; border-radius: 8px;
  border: 1px solid rgba(124,147,255,.28); background: rgba(61,92,255,.06);
}
.section-outcome b { display: block; color: var(--teal); font: 600 9px 'IBM Plex Mono', monospace; letter-spacing: .1em; margin-bottom: 5px; }
.section-outcome span { color: var(--text-muted); font-size: 11px; line-height: 1.5; }

/* Beginner tool setup */
.setup-callout {
  margin-bottom: 44px; padding: 18px; display: grid;
  grid-template-columns: 1.25fr repeat(5,1fr); gap: 1px;
  border: 1px solid var(--line); border-radius: 12px; background: var(--line);
}
.setup-callout > * { min-height: 54px; padding: 10px 14px; display: flex; align-items: center; gap: 9px; background: var(--surface); }
.setup-callout strong { color: var(--teal); font-size: 12px; }
.setup-callout div { color: var(--text-dim); font-size: 10px; line-height: 1.35; }
.setup-callout div span {
  width: 22px; height: 22px; flex: 0 0 auto; display: grid; place-items: center;
  border-radius: 50%; background: rgba(61,92,255,.13); color: var(--teal);
  font: 600 9px 'IBM Plex Mono', monospace;
}
.already-have { margin-bottom: 36px; display: grid; grid-template-columns: repeat(3,1fr); gap: 10px; }
.already-have > div { padding: 15px; display: grid; grid-template-columns: auto 1fr; gap: 4px 10px; border: 1px solid var(--line); border-radius: 9px; background: var(--surface); }
.already-have span { color: var(--teal); text-transform: uppercase; letter-spacing: .08em; font: 600 8px 'IBM Plex Mono', monospace; }
.already-have b { font-size: 11px; }
.already-have small { grid-column: 1/-1; color: var(--text-dim); font-size: 9px; line-height: 1.5; }
.setup-stages,
.learning-modules { display: grid; gap: 10px; }
.setup-stage,
.learning-module { overflow: hidden; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
.setup-stage > summary,
.learning-module > summary {
  min-height: 76px; padding: 15px 18px; display: grid;
  grid-template-columns: auto 1fr auto; gap: 16px; align-items: center;
  cursor: pointer; list-style: none;
}
.setup-stage > summary::-webkit-details-marker,
.learning-module > summary::-webkit-details-marker { display: none; }
.setup-stage > summary > span,
.learning-module > summary > span {
  min-width: 52px; color: var(--teal); text-transform: uppercase;
  letter-spacing: .08em; font: 600 9px 'IBM Plex Mono', monospace;
}
.setup-stage > summary > div,
.learning-module > summary > div { display: grid; gap: 3px; }
.setup-stage > summary b,
.learning-module > summary b { font-size: 13px; }
.setup-stage > summary small,
.learning-module > summary small { color: var(--text-dim); font-size: 10px; }
.setup-stage > summary i,
.learning-module > summary i { color: var(--teal); font-size: 9px; font-style: normal; }
.setup-stage > summary i::after,
.learning-module > summary i::after { content: " +"; }
.setup-stage[open] > summary,
.learning-module[open] > summary { border-bottom: 1px solid var(--line); background: rgba(61,92,255,.055); }
.setup-stage[open] > summary i::after,
.learning-module[open] > summary i::after { content: " −"; }
.setup-stage-content { padding: 0 20px 24px; }
.setup-stage-content > .tool-section-head { margin-top: 24px; }
.setup-stage-content > .setup-finish { margin-top: 20px; }
.learning-module-content { padding: 20px; }
.learning-module-content > :first-child { margin-top: 0; }
.learning-module-content > :last-child { margin-bottom: 0; }
.tool-section-head { margin: 46px 0 18px; display: flex; align-items: flex-end; justify-content: space-between; gap: 28px; }
.tool-section-head > div { display: grid; gap: 10px; }
.tool-section-head h3 { font: 700 24px 'Space Grotesk', sans-serif; }
.tool-section-head > p { max-width: 470px; color: var(--text-dim); font-size: 12px; line-height: 1.6; }
.tool-level {
  width: fit-content; padding: 4px 8px; display: inline-flex; border-radius: 99px;
  text-transform: uppercase; letter-spacing: .08em; font: 600 8px 'IBM Plex Mono', monospace;
}
.tool-level--required { border: 1px solid rgba(75,205,137,.32); background: rgba(75,205,137,.08); color: #62d899; }
.tool-level--account { border: 1px solid rgba(124,147,255,.35); background: rgba(61,92,255,.08); color: var(--teal); }
.tool-level--conditional { border: 1px solid rgba(239,177,76,.35); background: rgba(239,177,76,.08); color: #efb14c; }
.tool-level--optional { border: 1px solid var(--line); background: var(--surface-2); color: var(--text-muted); }
.tool-install-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px; }
.install-card {
  min-width: 0; min-height: 390px; padding: 22px; display: flex; flex-direction: column;
  border: 1px solid var(--line); border-radius: 12px; background: var(--surface);
}
.install-card-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.install-number { color: var(--teal); font: 600 11px 'IBM Plex Mono', monospace; }
.install-card h3 { margin: 24px 0 9px; font: 700 19px 'Space Grotesk', sans-serif; }
.install-card > p { color: var(--text-dim); font-size: 11px; line-height: 1.65; }
.install-choice { margin: 16px 0; padding: 10px; border-radius: 6px; background: var(--surface-2); color: var(--text-dim); font-size: 10px; line-height: 1.5; }
.install-choice b { color: var(--text); }
.install-card > a,
.runtime-grid a,
.optional-tools details a {
  width: fit-content; color: var(--teal); text-decoration: underline; text-underline-offset: 3px;
  font-size: 11px; font-weight: 700;
}
.install-card > code {
  margin-top: auto; padding: 11px; display: block; border: 1px solid var(--line);
  border-radius: 6px; background: var(--bg); color: #a9b6ff; font: 500 10px 'IBM Plex Mono', monospace;
}
.install-card > small { margin-top: 10px; color: var(--text-dim); font-size: 9px; line-height: 1.5; }
.install-sub-link { margin-top: 7px; color: var(--text-muted) !important; }
.os-quick-guides { margin-top: 14px; display: grid; grid-template-columns: repeat(3,1fr); gap: 10px; }
.os-quick-guides details { border: 1px solid var(--line); border-radius: 9px; background: var(--surface); }
.os-quick-guides summary { padding: 15px; display: grid; gap: 4px; cursor: pointer; }
.os-quick-guides summary b { font-size: 11px; }
.os-quick-guides summary span { color: var(--text-dim); font-size: 9px; }
.os-quick-guides ol { padding: 0 18px 17px 33px; color: var(--text-dim); font-size: 10px; line-height: 1.6; }
.os-quick-guides li + li { margin-top: 6px; }
.os-quick-guides code { color: var(--teal); font: 500 9px 'IBM Plex Mono', monospace; }
.runtime-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 12px; }
.runtime-grid article {
  padding: 22px; display: grid; gap: 15px; border: 1px solid var(--line);
  border-radius: 12px; background: var(--surface);
}
.runtime-grid article > div span { color: var(--teal); text-transform: uppercase; letter-spacing: .08em; font: 600 8px 'IBM Plex Mono', monospace; }
.runtime-grid h3 { margin-top: 5px; font: 700 18px 'Space Grotesk', sans-serif; }
.runtime-grid p { color: var(--text-dim); font-size: 11px; line-height: 1.6; }
.runtime-grid pre,
.setup-finish pre { padding: 14px; overflow-x: auto; border: 1px solid var(--line); border-radius: 7px; background: var(--bg); }
.runtime-grid pre code,
.setup-finish pre code { color: #a9b6ff; font: 500 10px/1.75 'IBM Plex Mono', monospace; }
.optional-tools { overflow: hidden; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
.optional-tools details { border-bottom: 1px solid var(--line); }
.optional-tools details:last-child { border-bottom: 0; }
.optional-tools summary {
  padding: 17px 20px; display: grid; grid-template-columns: 105px 170px 1fr;
  gap: 18px; align-items: center; cursor: pointer;
}
.optional-tools summary span { color: var(--teal); text-transform: uppercase; letter-spacing: .08em; font: 600 8px 'IBM Plex Mono', monospace; }
.optional-tools summary b { font-size: 12px; }
.optional-tools summary small { color: var(--text-dim); font-size: 10px; }
.optional-tools details > div { padding: 0 20px 18px 313px; display: flex; flex-wrap: wrap; gap: 10px 18px; }
.optional-tools details p { width: 100%; color: var(--text-dim); font-size: 11px; line-height: 1.6; }
.setup-finish {
  margin-top: 28px; padding: 26px; display: grid; grid-template-columns: 1.1fr .9fr auto;
  gap: 24px; align-items: center; border: 1px solid rgba(124,147,255,.35);
  border-radius: 12px; background: rgba(61,92,255,.06);
}
.roadmap-module { margin-top: 22px; }
.roadmap-module .feature-roadmap { margin-top: 0; }
.setup-finish > div > span { color: var(--teal); text-transform: uppercase; letter-spacing: .08em; font: 600 8px 'IBM Plex Mono', monospace; }
.setup-finish h3 { margin: 7px 0; font: 700 19px 'Space Grotesk', sans-serif; }
.setup-finish p { color: var(--text-dim); font-size: 10px; line-height: 1.55; }

/* Guided website navigation */
.timeline-nav {
  width: min(1000px, calc(100% - 32px)); max-width: none; overflow: hidden;
  border-radius: 16px; background: rgba(8,8,12,.92); backdrop-filter: blur(20px);
  box-shadow: 0 18px 55px rgba(0,0,0,.45);
}
.guide-nav-status {
  display: grid; grid-template-columns: 1fr 190px; gap: 22px; align-items: center;
  padding: 13px 18px 11px; border-bottom: 1px solid var(--line);
}
.guide-nav-copy { min-width: 0; display: grid; grid-template-columns: auto auto 1fr; gap: 10px; align-items: baseline; }
.guide-nav-copy > span { color: var(--teal); font: 600 9px 'IBM Plex Mono', monospace; letter-spacing: .09em; white-space: nowrap; }
.guide-nav-copy strong { font-size: 13px; white-space: nowrap; }
.guide-nav-copy small { color: var(--text-dim); font-size: 10px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.guide-nav-progress { height: 4px; overflow: hidden; border-radius: 99px; background: var(--line); }
.guide-nav-progress span {
  display: block; width: 20%; height: 100%; border-radius: inherit;
  background: linear-gradient(90deg, var(--gold), var(--teal)); transition: width .35s ease;
}
.timeline-track { min-height: 60px; padding: 5px 8px; display: flex; align-items: center; gap: 6px; overflow: visible; }
.nav-links-wrap { min-width: 0; flex: 1; display: grid; grid-template-columns: repeat(5, 1fr); position: relative; }
.marker {
  min-width: 0; padding: 9px 10px; display: flex; flex-direction: row; gap: 7px;
  border: 0; background: transparent; color: var(--text-dim); cursor: pointer;
  align-items: center; justify-content: center; position: relative; z-index: 1;
}
.marker-number { color: inherit; font: 600 9px 'IBM Plex Mono', monospace; }
.marker .label { color: inherit; font: 700 11px 'Space Grotesk', sans-serif; }
.marker:hover { color: var(--text); transform: none; }
.marker.completed { color: #8fa1ff; }
.marker.completed .marker-number::after { content: "✓"; margin-left: 3px; }
.marker.active { color: #fff; }
.marker.active .label { color: #fff; transform: none; text-shadow: 0 0 12px rgba(90,117,255,.8); }
.nav-highlighter {
  position: absolute; top: 4px; bottom: 4px; height: auto; z-index: 0;
  border-radius: 9px; background: rgba(61,92,255,.2); border: 1px solid rgba(124,147,255,.42);
  transition: left .3s ease, width .3s ease;
}
.guide-nav-arrow {
  min-height: 38px; padding: 7px 9px; display: flex; align-items: center; gap: 5px;
  border: 1px solid var(--line); border-radius: 8px; background: var(--surface);
  color: var(--text); cursor: pointer; font: 600 11px 'Space Grotesk', sans-serif;
}
.guide-nav-arrow:hover:not(:disabled) { color: var(--teal); border-color: var(--teal); }
.guide-nav-arrow span { font-size: 15px; line-height: 1; }
.timeline-track > .btn-icon { width: 38px; height: 38px; border-radius: 8px; }

/* Planner */
.builder-badge {
  color: var(--teal); text-transform: uppercase; letter-spacing: .1em;
  font: 600 10px 'IBM Plex Mono', monospace;
}
.guided-builder {
  overflow: hidden; border: 1px solid var(--line); border-radius: 18px;
  background: var(--surface); box-shadow: 0 30px 90px rgba(0,0,0,.3);
}
.guided-builder-head {
  padding: 30px 34px; display: flex; justify-content: space-between; align-items: center; gap: 28px;
  border-bottom: 1px solid var(--line);
  background: radial-gradient(circle at 100% 0, rgba(61,92,255,.18), transparent 38%), var(--surface);
}
.guided-builder-head h3 { margin: 10px 0 6px; font: 700 24px 'Space Grotesk', sans-serif; letter-spacing: -.02em; }
.guided-builder-head p { color: var(--text-dim); font-size: 13px; }
.guided-readiness {
  min-width: 142px; padding: 15px 18px; border: 1px solid rgba(124,147,255,.3);
  background: rgba(61,92,255,.08); border-radius: 10px; text-align: right;
}
.guided-readiness strong { display: block; color: var(--teal); font: 700 22px 'IBM Plex Mono', monospace; }
.guided-readiness span { color: var(--text-muted); font-size: 11px; }
.guided-progress {
  position: relative; padding: 24px 30px 20px; display: grid; grid-template-columns: repeat(6,1fr);
  background: var(--bg); border-bottom: 1px solid var(--line);
}
.guided-progress-line { position: absolute; left: calc(8.33% + 18px); right: calc(8.33% + 18px); top: 42px; height: 2px; background: var(--line); }
.guided-progress-line span { display: block; width: 0; height: 100%; background: var(--gold); transition: width .3s ease; }
.guided-progress-step {
  position: relative; z-index: 1; display: grid; justify-items: center; gap: 8px;
  border: 0; background: transparent; color: var(--text-dim); cursor: pointer;
}
.guided-progress-step b {
  width: 36px; height: 36px; display: grid; place-items: center; border-radius: 50%;
  border: 1px solid var(--line); background: var(--surface); font: 600 11px 'IBM Plex Mono', monospace;
}
.guided-progress-step span { font-size: 11px; font-weight: 600; }
.guided-progress-step.active { color: var(--text); }
.guided-progress-step.active b { color: #fff; background: var(--gold); border-color: var(--gold); box-shadow: 0 0 0 5px var(--gold-glow); }
.guided-progress-step.complete b { color: #fff; background: var(--gold); border-color: var(--gold); }
.guided-content { min-height: 560px; }
.guided-panel { display: none; max-width: none; margin: 0; padding: 38px 42px 34px; animation: guide-in .25s ease; }
.guided-panel.active { display: block; }
@keyframes guide-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
.guided-panel-heading { max-width: 730px; margin-bottom: 30px; }
.guided-panel-heading > span { color: var(--teal); text-transform: uppercase; letter-spacing: .1em; font: 600 10px 'IBM Plex Mono', monospace; }
.guided-panel-heading h4 { margin: 8px 0 7px; font: 700 25px 'Space Grotesk', sans-serif; letter-spacing: -.02em; }
.guided-panel-heading p { color: var(--text-dim); font-size: 14px; line-height: 1.65; }
.tool-choice-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 12px; }
.tool-choice {
  min-height: 82px; padding: 14px 15px; display: grid; grid-template-columns: auto 1fr auto;
  gap: 12px; align-items: center; text-align: left; border: 1px solid var(--line);
  border-radius: 10px; background: var(--bg); color: var(--text); cursor: pointer; transition: .2s ease;
}
.tool-choice:hover { transform: translateY(-2px); border-color: rgba(124,147,255,.55); }
.tool-choice.selected { border-color: var(--gold); background: rgba(61,92,255,.09); box-shadow: inset 0 0 0 1px var(--gold); }
.tool-mark { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 8px; background: var(--surface-2); color: var(--teal); font: 700 11px 'IBM Plex Mono', monospace; }
.tool-choice strong,
.tool-choice small { display: block; }
.tool-choice strong { font-size: 14px; }
.tool-choice small { color: var(--text-dim); font-size: 11px; margin-top: 3px; }
.tool-choice i { color: var(--teal); font-style: normal; opacity: 0; }
.tool-choice.selected i { opacity: 1; }
.planner-fields { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18px; }
.planner-field { min-width: 0; display: flex; flex-direction: column; gap: 7px; }
.planner-field--wide { grid-column: 1/-1; }
.planner-field label { color: var(--text-muted); font-size: 12px; font-weight: 600; }
.planner-field input,
.planner-field textarea,
.planner-field select {
  width: 100%; padding: 11px 12px; border: 1px solid var(--line); border-radius: 5px;
  background: var(--bg); color: var(--text); outline: none; resize: vertical;
  font: 400 13px/1.5 'Space Grotesk', sans-serif;
}
.planner-field select { min-height: 43px; }
.planner-field textarea { min-height: 100px; }
.planner-field input:focus,
.planner-field textarea:focus,
.planner-field select:focus { border-color: var(--teal); box-shadow: 0 0 0 3px rgba(124,147,255,.11); }
.guided-tip,
.guided-example {
  margin-top: 22px; padding: 14px 16px; border: 1px solid rgba(124,147,255,.25);
  border-radius: 8px; background: rgba(61,92,255,.06); color: var(--text-muted);
  font-size: 12px; line-height: 1.6;
}
.guided-tip b,
.guided-example b { color: var(--teal); }
.guided-example p { margin-top: 4px; }
.guided-footer {
  min-height: 72px; padding: 14px 30px; display: grid; grid-template-columns: 1fr auto 1fr;
  align-items: center; gap: 18px; border-top: 1px solid var(--line); background: var(--surface-2);
}
.guided-footer > span { color: var(--text-dim); text-align: center; font-size: 11px; }
.guided-footer > span b { color: var(--text); }
.guided-footer #guided-prev-btn { justify-self: start; }
.guided-footer #guided-next-btn { justify-self: end; min-width: 210px; }
.prompt-use-strip { display: grid; grid-template-columns: repeat(4,1fr); overflow: hidden; margin-bottom: 22px; border: 1px solid var(--line); border-radius: 10px; }
.prompt-use-strip > div { display: flex; gap: 10px; padding: 14px; border-right: 1px solid var(--line); background: var(--surface-2); }
.prompt-use-strip > div:last-child { border-right: 0; }
.prompt-use-strip b { width: 25px; height: 25px; flex: 0 0 auto; display: grid; place-items: center; border-radius: 50%; background: var(--gold); color: #fff; font: 600 10px 'IBM Plex Mono', monospace; }
.prompt-use-strip strong,
.prompt-use-strip small { display: block; }
.prompt-use-strip strong { font-size: 12px; }
.prompt-use-strip small { color: var(--text-dim); margin-top: 2px; font-size: 10px; }

/* Generated output */
.planner-output { overflow: hidden; border: 1px solid #202020; border-radius: 12px; background: #030303; color: #f0f0ee; }
.planner-output-top { padding: 30px 34px; display: flex; justify-content: space-between; gap: 22px; border-bottom: 1px solid #202020; }
.planner-output-top h3 { margin: 9px 0 6px; color: #f0f0ee !important; font-size: 22px; }
.planner-output-top p { max-width: 590px; color: #7a7a88 !important; font-size: 13px; }
.planner-actions { display: flex; align-items: flex-start; flex-wrap: wrap; gap: 8px; }
.planner-output-tabs { padding: 13px 18px; display: flex; gap: 6px; overflow-x: auto; border-bottom: 1px solid #202020; }
.planner-output-tab { flex: 0 0 auto; padding: 7px 11px; border: 1px solid #252525; border-radius: 99px; background: #0b0b0b; color: #858593; cursor: pointer; font: 600 10px 'IBM Plex Mono', monospace; }
.planner-output-tab.active { color: #fff; border-color: #526dff; background: rgba(61,92,255,.2); }
.planner-preview-head { padding: 12px 20px; display: flex; justify-content: space-between; align-items: center; gap: 16px; border-bottom: 1px solid #202020; color: #a0b0ff; font: 500 11px 'IBM Plex Mono', monospace; }
.planner-code { max-height: 660px; margin: 0; padding: 24px; overflow: auto; border: 0; background: #030303; color: #cbd1dc; white-space: pre-wrap; font: 400 12px/1.72 'IBM Plex Mono', monospace; }

/* Build guidance */
.build-loop { display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; overflow: hidden; margin-bottom: 24px; border: 1px solid var(--line); border-radius: 14px; background: var(--line); }
.build-loop article { min-height: 180px; padding: 25px 22px; display: flex; gap: 15px; background: var(--surface); }
.build-loop article > b { flex: 0 0 auto; color: var(--teal); font: 600 10px 'IBM Plex Mono', monospace; }
.build-loop h3 { margin-bottom: 9px; font: 700 16px 'Space Grotesk', sans-serif; }
.build-loop p { color: var(--text-dim); font-size: 12px; line-height: 1.65; }
.prompt-formula { display: grid; grid-template-columns: 1fr 1.35fr; overflow: hidden; margin-bottom: 24px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); }
.prompt-formula-intro { padding: 32px; border-right: 1px solid var(--line); }
.prompt-formula-intro > span { color: var(--teal); text-transform: uppercase; letter-spacing: .1em; font: 600 10px 'IBM Plex Mono', monospace; }
.prompt-formula-intro h3 { margin: 10px 0; font: 700 27px 'Space Grotesk', sans-serif; }
.prompt-formula-intro p { color: var(--text-dim); font-size: 13px; line-height: 1.65; }
.prompt-formula-parts { display: grid; grid-template-columns: repeat(5,1fr); }
.prompt-formula-parts > div { padding: 24px 14px; display: flex; flex-direction: column; border-right: 1px solid var(--line); }
.prompt-formula-parts > div:last-child { border-right: 0; }
.prompt-formula-parts b { color: var(--teal); font: 600 10px 'IBM Plex Mono', monospace; }
.prompt-formula-parts strong { margin: 18px 0 6px; font-size: 13px; }
.prompt-formula-parts span { color: var(--text-dim); font-size: 11px; line-height: 1.5; }
.context-routing { display: grid; grid-template-columns: .8fr 1.2fr; overflow: hidden; margin: 24px 0; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); }
.context-routing-intro { padding: 30px; border-right: 1px solid var(--line); }
.context-routing-intro h3 { margin: 8px 0 10px; font: 700 22px 'Space Grotesk', sans-serif; }
.context-routing-intro p { color: var(--text-dim); font-size: 12px; line-height: 1.65; }
.context-routing-list { display: grid; }
.context-routing-list > div { padding: 14px 20px; display: grid; grid-template-columns: 150px 1fr; gap: 18px; align-items: center; border-bottom: 1px solid var(--line); }
.context-routing-list > div:last-child { border-bottom: 0; }
.context-routing-list code { color: var(--teal); font: 600 11px 'IBM Plex Mono', monospace; }
.context-routing-list span { color: var(--text-dim); font-size: 12px; }
.prompt-comparison { margin-top: 24px; padding: 30px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); }
.prompt-comparison-head { margin-bottom: 24px; display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; }
.prompt-comparison-head h3 { font: 700 23px 'Space Grotesk', sans-serif; }
.prompt-comparison-head > p { max-width: 300px; color: var(--text-dim); font-size: 12px; }
.prompt-comparison-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 14px; }
.prompt-example { padding: 22px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); }
.prompt-example > span { text-transform: uppercase; letter-spacing: .1em; font: 600 10px 'IBM Plex Mono', monospace; }
.prompt-example--bad > span { color: #e47777; }
.prompt-example--good { border-color: rgba(124,147,255,.45); background: rgba(61,92,255,.045); }
.prompt-example--good > span { color: var(--teal); }
.prompt-example blockquote { margin: 18px 0; font-size: 13px; line-height: 1.7; }
.prompt-example ul { list-style: none; display: grid; gap: 8px; }
.prompt-example li { position: relative; padding-left: 16px; color: var(--text-dim); font-size: 11px; }
.prompt-example li::before { content: "–"; position: absolute; left: 0; }

/* Folder explorer */
.folder-explorer-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
.tree-card { max-height: 470px; padding: 20px; overflow: auto; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); font: 400 12px 'IBM Plex Mono', monospace; }
.tree-node { display: block; }
.tree-node-content { width: 100%; padding: 6px; display: flex; align-items: center; gap: 8px; border: 0; border-left: 2px solid transparent; border-radius: 4px; background: transparent; color: var(--text-dim); cursor: pointer; text-align: left; white-space: nowrap; font: 400 12px 'IBM Plex Mono', monospace; }
.tree-node-content:hover { color: var(--text); background: var(--surface-2); }
.tree-node-content.selected { color: var(--teal); background: rgba(61,92,255,.1); border-left-color: var(--teal); }
.tree-children { padding-left: 18px; }
.node-desc-preview { overflow: hidden; color: var(--text-dim); opacity: .7; text-overflow: ellipsis; font-size: 10px; }
.icon-folder { color: #8da0ff; flex: 0 0 auto; }
.icon-file { color: var(--text-dim); flex: 0 0 auto; }
.icon-context { color: var(--teal); flex: 0 0 auto; }
.tree-detail-box { padding: 24px; display: flex; flex-direction: column; gap: 16px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); }
.detail-header { display: flex; align-items: center; gap: 10px; }
.detail-icon { font-size: 18px; }
.detail-name { color: var(--teal); font: 700 16px 'IBM Plex Mono', monospace; }
.detail-desc { color: var(--text-dim); font-size: 14px; line-height: 1.6; }
.structure-rules { margin-top: 8px; padding-top: 18px; border-top: 1px solid var(--line); }
.structure-rules h3 { margin-bottom: 12px; font: 700 15px 'Space Grotesk', sans-serif; }
.structure-rules ul { list-style: none; display: grid; gap: 9px; }
.structure-rules li { position: relative; padding-left: 17px; color: var(--text-dim); font-size: 12px; line-height: 1.5; }
.structure-rules li::before { content: "✓"; position: absolute; left: 0; color: var(--teal); }

/* Launch gates */
.launch-gates { display: grid; grid-template-columns: repeat(4,1fr); gap: 1px; overflow: hidden; border: 1px solid var(--line); border-radius: 14px; background: var(--line); }
.launch-gates article { min-height: 270px; padding: 25px 20px; background: var(--surface); }
.launch-gates article > span { color: var(--teal); text-transform: uppercase; letter-spacing: .08em; font: 600 9px 'IBM Plex Mono', monospace; }
.launch-gates h3 { margin: 25px 0 15px; font: 700 16px 'Space Grotesk', sans-serif; }
.launch-gates ul { list-style: none; display: grid; gap: 10px; }
.launch-gates li { position: relative; padding-left: 15px; color: var(--text-dim); font-size: 11px; line-height: 1.5; }
.launch-gates li::before { content: "□"; position: absolute; left: 0; color: var(--teal); }
.final-reminder { margin-top: 18px; padding: 18px 20px; display: grid; grid-template-columns: auto 1fr auto; gap: 20px; align-items: center; border: 1px solid rgba(124,147,255,.3); border-radius: 10px; background: rgba(61,92,255,.07); }
.final-reminder strong { color: var(--teal); font-size: 13px; }
.final-reminder p { color: var(--text-muted); font-size: 12px; }
.final-reminder a { font-size: 12px; font-weight: 700; }

/* Planner workspace, coaching, and beginner education */
.planner-workspace {
  padding: 14px 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  border-bottom: 1px solid var(--line);
  background: var(--surface-2);
}
.planner-workspace-copy { min-width: 210px; display: grid; gap: 3px; }
.planner-workspace-copy > span:last-child { color: var(--text-dim); font-size: 10px; }
.sync-indicator { display: flex; align-items: center; gap: 7px; font-size: 11px; }
.sync-indicator i { width: 7px; height: 7px; border-radius: 50%; background: #45b97c; box-shadow: 0 0 0 4px rgba(69,185,124,.1); }
.planner-workspace-actions { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 7px; }
.saved-project-label { color: var(--text-dim); font-size: 10px; }
.planner-workspace select {
  min-height: 34px;
  padding: 0 28px 0 10px;
  border: 1px solid var(--line);
  border-radius: 5px;
  background: var(--bg);
  color: var(--text);
  font: 500 11px 'Space Grotesk', sans-serif;
}
.planner-workspace .btn-secondary,
.planner-workspace .btn-sm-primary { min-height: 34px; padding: 0 11px; font-size: 10px; }
.planner-field-label { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.field-help-toggle {
  border: 0;
  background: transparent;
  color: var(--teal);
  cursor: pointer;
  font: 600 9px 'IBM Plex Mono', monospace;
}
.field-help-toggle[aria-expanded="true"] { text-decoration: underline; }
.field-coaching {
  margin-top: 8px;
  padding: 10px;
  border-left: 2px solid var(--teal);
  border-radius: 0 6px 6px 0;
  background: rgba(61,92,255,.065);
}
.field-coaching p { color: var(--text-dim); font-size: 11px; line-height: 1.55; }
.suggestion-chips { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 6px; }
.suggestion-chip {
  padding: 6px 8px;
  border: 1px solid rgba(124,147,255,.3);
  border-radius: 999px;
  background: var(--surface);
  color: var(--text-muted);
  cursor: pointer;
  font-size: 10px;
  line-height: 1.3;
}
.suggestion-chip:hover { border-color: var(--teal); color: var(--text); }
.beginner-start { margin-bottom: 28px; overflow: hidden; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); }
.beginner-start-intro { padding: 28px; border-bottom: 1px solid var(--line); }
.beginner-start-intro h3,
.feature-roadmap h3 { margin: 6px 0 10px; font: 700 24px 'Space Grotesk', sans-serif; }
.beginner-start-intro p { max-width: 780px; color: var(--text-dim); font-size: 13px; line-height: 1.7; }
.setup-grid { display: grid; grid-template-columns: repeat(4,1fr); border-bottom: 1px solid var(--line); }
.setup-grid article { min-height: 190px; padding: 22px; border-right: 1px solid var(--line); }
.setup-grid article:last-child { border-right: 0; }
.setup-grid article > span { color: var(--teal); text-transform: uppercase; letter-spacing: .09em; font: 600 9px 'IBM Plex Mono', monospace; }
.setup-grid h4 { margin: 20px 0 9px; font: 700 14px 'Space Grotesk', sans-serif; }
.setup-grid p,
.learning-accordions p { color: var(--text-dim); font-size: 11px; line-height: 1.65; }
.learning-accordions details { border-bottom: 1px solid var(--line); }
.learning-accordions details:last-child { border-bottom: 0; }
.learning-accordions summary { padding: 17px 22px; cursor: pointer; font-size: 12px; font-weight: 700; }
.learning-accordions p { max-width: 860px; padding: 0 22px 18px; }
.feature-roadmap { margin-top: 24px; padding: 28px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); }
.feature-roadmap ul { margin-top: 22px; display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; list-style: none; background: var(--line); }
.feature-roadmap li { min-height: 125px; padding: 18px; display: flex; flex-direction: column; gap: 8px; background: var(--bg); }
.feature-roadmap li b { font-size: 12px; }
.feature-roadmap li span { color: var(--text-dim); font-size: 11px; line-height: 1.55; }

/* Search */
.cmd-modal-overlay { position: fixed; inset: 0; z-index: 9999; padding: 10vh 16px 0; display: flex; justify-content: center; align-items: flex-start; background: rgba(0,0,0,.65); backdrop-filter: blur(8px); opacity: 0; pointer-events: none; transition: opacity .2s ease; }
.cmd-modal-overlay.active { opacity: 1; pointer-events: auto; }
.cmd-modal-content { width: min(600px,100%); overflow: hidden; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); box-shadow: 0 24px 48px rgba(0,0,0,.4); transform: translateY(-10px) scale(.97); transition: transform .2s ease; }
.cmd-modal-overlay.active .cmd-modal-content { transform: none; }
.cmd-modal-header { padding: 16px 20px; display: flex; align-items: center; border-bottom: 1px solid var(--line); }
.cmd-search-icon { margin-right: 12px; color: var(--teal); }
#cmd-input { min-width: 0; flex: 1; border: 0; outline: 0; background: transparent; color: var(--text); font: 400 16px 'Space Grotesk', sans-serif; }
.cmd-kbd { padding: 4px 8px; border: 1px solid var(--line); border-radius: 3px; background: var(--surface-2); color: var(--text-dim); font: 600 10px 'IBM Plex Mono', monospace; }
.cmd-results { max-height: 400px; overflow-y: auto; }
.cmd-empty { padding: 22px; color: var(--text-dim); text-align: center; font-size: 12px; }
.cmd-result-item { width: 100%; padding: 15px 18px; border: 0; border-bottom: 1px solid var(--line); background: transparent; color: var(--text); text-align: left; cursor: pointer; }
.cmd-result-item:hover { background: var(--surface-2); }
.cmd-result-title,
.cmd-result-desc { display: block; }
.cmd-result-title { font-size: 13px; font-weight: 700; }
.cmd-result-desc { margin-top: 4px; color: var(--text-dim); font-size: 10px; }

/* Toast */
.toast-container { position: fixed; right: 24px; bottom: 150px; z-index: 10000; display: grid; gap: 8px; }
.toast { padding: 12px 18px; display: flex; align-items: center; gap: 10px; border: 1px solid var(--teal); border-radius: 8px; background: var(--surface-2); color: var(--text); box-shadow: 0 8px 28px rgba(0,0,0,.45); font-size: 13px; transition: .3s ease; }

/* Light theme */
[data-theme="light"] .timeline-nav { background: rgba(255,255,255,.95); box-shadow: 0 18px 55px rgba(15,23,42,.16); }
[data-theme="light"] .guided-builder,
[data-theme="light"] .tree-card,
[data-theme="light"] .tree-detail-box,
[data-theme="light"] .prompt-formula,
[data-theme="light"] .context-routing,
[data-theme="light"] .prompt-comparison { background: #fff; }
[data-theme="light"] .beginner-start,
[data-theme="light"] .feature-roadmap { background: #fff; }
[data-theme="light"] .planner-field input,
[data-theme="light"] .planner-field textarea,
[data-theme="light"] .planner-field select { background: #fff; border-color: #cbd5e1; }

@media (max-width: 1024px) {
  .header-path { display: none; }
  .setup-callout { grid-template-columns: repeat(3,1fr); }
  .setup-callout strong { grid-column: 1/-1; }
  .tool-install-grid { grid-template-columns: repeat(2,1fr); }
  .os-quick-guides { grid-template-columns: 1fr; }
  .setup-finish { grid-template-columns: 1fr 1fr; }
  .setup-finish > a { grid-column: 1/-1; }
  .tool-choice-grid { grid-template-columns: repeat(2,1fr); }
  .build-loop { grid-template-columns: repeat(2,1fr); }
  .launch-gates { grid-template-columns: repeat(2,1fr); }
  .setup-grid { grid-template-columns: repeat(2,1fr); }
  .setup-grid article:nth-child(2) { border-right: 0; }
  .setup-grid article:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
  .feature-roadmap ul { grid-template-columns: repeat(2,1fr); }
  .planner-workspace { align-items: flex-start; flex-direction: column; }
  .planner-workspace-actions { justify-content: flex-start; }
  .prompt-formula { grid-template-columns: 1fr; }
  .prompt-formula-intro { border-right: 0; border-bottom: 1px solid var(--line); }
}

@media (max-width: 700px) {
  html, body, #app, main { width: 100%; max-width: 100vw; overflow-x: hidden; }
  .hero, section.section { width: 100vw; }
  .hero, .hero > *, .section, .section > * { min-width: 0; max-width: 100%; }
  .hero-pill { display: block; width: fit-content; white-space: normal; overflow-wrap: anywhere; }
  .hero-description, .hero-feature-text p { overflow-wrap: anywhere; }
  .hero-features { grid-template-columns: minmax(0,1fr); }
  .focused-section-head,
  .prompt-comparison-head { align-items: flex-start; flex-direction: column; }
  .setup-callout,
  .already-have,
  .tool-install-grid,
  .runtime-grid,
  .setup-finish { grid-template-columns: 1fr; }
  .setup-callout strong,
  .setup-finish > a { grid-column: auto; }
  .tool-section-head { margin-top: 38px; align-items: flex-start; flex-direction: column; gap: 9px; }
  .tool-section-head h3 { font-size: 20px; }
  .setup-stage > summary,
  .learning-module > summary { grid-template-columns: auto 1fr; gap: 10px; }
  .setup-stage > summary > span,
  .learning-module > summary > span { min-width: 42px; }
  .setup-stage > summary > i,
  .learning-module > summary > i { display: none; }
  .setup-stage-content,
  .learning-module-content { padding: 14px; }
  .install-card { min-height: 340px; }
  .optional-tools summary { grid-template-columns: 1fr; gap: 5px; }
  .optional-tools details > div { padding: 0 18px 18px; }
  .section-outcome { width: 100%; }
  .guided-builder-head { padding: 22px 18px; align-items: flex-start; }
  .guided-builder-head h3 { font-size: 20px; }
  .guided-readiness { min-width: 92px; padding: 10px; }
  .guided-readiness strong { font-size: 17px; }
  .guided-progress { padding: 16px; display: flex; gap: 18px; overflow-x: auto; }
  .guided-progress-line { display: none; }
  .guided-progress-step { flex: 0 0 auto; grid-template-columns: auto auto; align-items: center; gap: 7px; }
  .guided-progress-step b { width: 28px; height: 28px; }
  .guided-panel { padding: 26px 18px; }
  .guided-panel-heading h4 { font-size: 21px; }
  .tool-choice-grid,
  .planner-fields,
  .build-loop,
  .context-routing,
  .prompt-comparison-grid,
  .folder-explorer-layout,
  .launch-gates { grid-template-columns: 1fr; }
  .setup-grid,
  .feature-roadmap ul { grid-template-columns: 1fr; }
  .setup-grid article { min-height: auto; border-right: 0; border-bottom: 1px solid var(--line); }
  .setup-grid article:last-child { border-bottom: 0; }
  .planner-workspace-actions,
  .planner-workspace-actions select,
  .planner-workspace-actions button { width: 100%; }
  .saved-project-label { width: 100%; }
  .planner-field--wide { grid-column: auto; }
  .context-routing-intro { border-right: 0; border-bottom: 1px solid var(--line); }
  .context-routing-list > div { grid-template-columns: 112px 1fr; }
  .prompt-formula-parts { grid-template-columns: 1fr; }
  .prompt-formula-parts > div { padding: 15px; display: grid; grid-template-columns: 30px 86px 1fr; align-items: center; border-right: 0; border-bottom: 1px solid var(--line); }
  .prompt-formula-parts > div:last-child { border-bottom: 0; }
  .prompt-formula-parts strong { margin: 0; }
  .build-loop article,
  .launch-gates article { min-height: auto; }
  .prompt-comparison { padding: 20px 15px; }
  .planner-output-top { padding: 22px 16px; flex-direction: column; }
  .planner-actions { width: 100%; }
  .planner-actions button { flex: 1; }
  .planner-code { padding: 18px 14px; font-size: 11px; }
  .prompt-use-strip { grid-template-columns: repeat(2,1fr); }
  .prompt-use-strip > div:nth-child(2) { border-right: 0; }
  .prompt-use-strip > div:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
  .guided-footer { padding: 13px 16px 160px; grid-template-columns: 1fr 1fr; }
  .guided-footer > span { grid-column: 1/-1; grid-row: 1; }
  .guided-footer #guided-next-btn { min-width: 0; width: 100%; }
  .final-reminder { grid-template-columns: 1fr; }

  .timeline-nav { width: calc(100% - 20px); bottom: 10px; border-radius: 14px; }
  .guide-nav-status { padding: 10px 12px 8px; display: block; }
  .guide-nav-copy { grid-template-columns: auto 1fr; gap: 6px 9px; }
  .guide-nav-copy small { grid-column: 1/-1; white-space: normal; line-height: 1.4; }
  .guide-nav-progress { margin-top: 8px; }
  .timeline-track { min-height: 52px; padding: 4px; gap: 3px; }
  .nav-links-wrap { gap: 0; }
  .marker { padding: 8px 3px; flex-direction: column; gap: 2px; }
  .marker-number { font-size: 8px; }
  .marker .label { font-size: 9px; }
  .guide-nav-arrow { width: 34px; min-height: 38px; padding: 5px; justify-content: center; }
  .guide-nav-arrow small { display: none; }
  .timeline-track > .btn-icon { display: none; }
  .toast-container { right: 12px; bottom: 150px; left: 12px; }
}
